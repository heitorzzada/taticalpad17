# Configurações de Exemplo (Template) - TacticalPad Futsal Pro
# Copie este arquivo para .env e preencha as variáveis correspondentes.

SECRET_KEY=sua-chave-secreta-de-producao-aqui
DEBUG=False
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
DATABASE_URL=postgres://usuario:senha@host:5432/nome_banco

# Identidade da Escolinha
SCHOOL_NAME=Nome da Sua Escolinha de Futsal
SCHOOL_TAGLINE=Centro de Formação e Alto Rendimento
PRIMARY_COLOR=#004AAD
SECONDARY_COLOR=#FFCC00
PITCH_COLOR=#1E3A5F
PITCH_AREA_COLOR=#142640
COURT_LINE_COLOR=#FFFFFF
